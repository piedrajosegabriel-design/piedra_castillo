/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/uploads/*
/writable/debugbar/*
!/writable/cache/index.html
!/writable/logs/index.html
!/writable/session/index.html
!/writable/uploads/index.html
!/writable/debugbar/index.html

# Configuracion local: es distinta en cada maquina (sobre todo el puerto de
# MySQL), asi que NO se versiona. La plantilla .env.example si se versiona:
# es la lista de que claves hay que completar.
.env
!.env.example

# Dependencias de Composer: se reinstalan con `composer install`, no se
# versionan. (El framework en si vive en system/, que si esta en el repo.)
/vendor/

# IDE / OS
.vscode/
.idea/
# Cursor guarda acá su cache, sus logs de debug y a veces una copia entera
# del proyecto. Una de esas copias se subió sin querer y hubo que borrarla.
.cursor/
.DS_Store
Thumbs.db

# Logs sueltos en raíz
*.log

# Cache de Python (lo genera Thonny/Python al compilar)
__pycache__/
*.pyc

# Archivos que la ESP32 se genera sola (no son del repo)
firmware/wifi.json
firmware/credenciales.json
