#--------------------------------------------------------------------
# PLANTILLA DE CONFIGURACION LOCAL — EdenAir
#--------------------------------------------------------------------
#
# COMO SE USA
#   1. Copia este archivo como `.env` (sin el .example) en la raiz.
#   2. Ajusta los valores a TU maquina (sobre todo el puerto de MySQL).
#   3. Nunca commitees tu `.env`: es distinto en cada computadora.
#
#      Windows:  copy .env.example .env
#      Linux:    cp .env.example .env
#
# POR QUE ESTE ARCHIVO EXISTE
#   El `.env` real esta en .gitignore porque cada maquina tiene su propia
#   configuracion. Pero alguien que clona el proyecto necesita saber QUE
#   claves hacen falta. Esta plantilla es esa lista, sin datos de nadie.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENTORNO
#--------------------------------------------------------------------
# Development muestra los errores en pantalla. En un servidor real: production.

CI_ENVIRONMENT = Development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# URL base que usan base_url() y site_url().
# Apunta a /public porque es el front-controller de CodeIgniter.
# Ajustala si serviis el proyecto desde otra carpeta o dominio.

app.baseURL = 'http://localhost/piedra_castillo/public/'
# Si tu servidor tiene problemas con el punto, usa la variante con guion bajo:
app_baseURL = 'http://localhost/piedra_castillo/public/'

# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# BASE DE DATOS
#--------------------------------------------------------------------
# Estos valores sobreescriben lo que hay en app/Config/Database.php.
# En XAMPP, el usuario root normalmente entra sin contraseña.
#
# EL PUERTO ES LO QUE MAS CAMBIA ENTRE MAQUINAS:
#   3306 -> el puerto habitual de MySQL / MariaDB
#   3307 -> cuando ya hay otro MySQL ocupando el 3306
#
# Si no sabes cual usar, fijate en C:\xampp\mysql\bin\my.ini, seccion [mysqld].

database.default.hostname = 127.0.0.1
database.default.database = tesina_esp32
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# APROVISIONAMIENTO DEL DISPOSITIVO (opcional)
#--------------------------------------------------------------------
# Credenciales del WiFi de configuracion que publica la ESP32. Son las que
# la web mete adentro del QR de vinculacion, asi que TIENEN que coincidir
# exactamente con las del firmware.
#
# Si no las defines, se usan las de DevicePairingService (EdenAir-Setup).
# Solo tocalas si cambiaste el firmware.

# edenair.apSsid = EdenAir-Setup
# edenair.apPassword = edenair.setup

#--------------------------------------------------------------------
# MERCADO PAGO (cobro de /panel/compra)
#--------------------------------------------------------------------
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# (Tu integracion -> Credenciales). Sin accessToken el boton de compra
# queda deshabilitado.
#
#   accessToken -> SECRETO. Solo lo usa el servidor. Nunca lo subas al repo.
#   publicKey   -> publica. El Checkout Pro por redireccion no la necesita.
#
# Para probar sin mover plata, usa las credenciales de una CUENTA DE PRUEBA
# vendedora y paga logueado con una cuenta de prueba compradora.

mercadopago.accessToken ="APP_USR-3281628818522668-091512-ab9aa518b218b824b9bbc229c1722f71-3693017012"
mercadopago.publicKey ="APP_USR-51ba3879-e73c-4dbe-9425-d3820fda1ae5"

# Webhook: URL publica a la que Mercado Pago avisa cada cambio de un pago.
# En localhost no hace falta (Mercado Pago no llega a tu maquina; el pago se
# confirma cuando el comprador vuelve al sitio). Con el sitio publicado en
# https se usa sola /api/pagos/mercadopago. Para probar con un tunel:
# mercadopago.notificationUrl = https://xxxx.ngrok-free.app/piedra_castillo/public/api/pagos/mercadopago

# Clave secreta de Webhooks (panel de Mercado Pago). Si esta, se verifica
# la firma x-signature de cada aviso.
# mercadopago.webhookSecret =

#--------------------------------------------------------------------
# OTROS (descomentar solo si hacen falta)
#--------------------------------------------------------------------

# encryption.key =
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# logger.threshold = 4
